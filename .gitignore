# Dépendances
node_modules/

# Résultats Playwright (générés à chaque exécution)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Session d'authentification générée par le setup (contient un token)
/playwright/.auth/

# Variables d'environnement locales (ne jamais commiter de secrets)
.env